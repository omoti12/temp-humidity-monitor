# 警報メールの設定（Gmailの例）
# このファイルを ~/.config/temp-monitor/mail.env にコピーして書き換える
# パスワードが入るので、このリポジトリにはコミットしないこと

# 送信元のGmailアドレス
MAIL_USER=送信用アドレス@gmail.com

# Gmailのアプリパスワード（16文字。スペースはあってもなくてもよい）
MAIL_PASSWORD=abcd efgh ijkl mnop

# 受け取るアドレス。複数ならカンマ区切り
# サイトの「警報メールの宛先」画面で一度でも追加・削除すると、以降はそちらの一覧
# （~/.config/temp-monitor/recipients.json）が使われ、この行は使われなくなる
MAIL_TO=受け取るアドレス@example.com

# サイトから宛先を追加・削除するときの管理用パスワード（半角英数字で、長めに）
# 空のままだと、サイトからの変更はできない
ADMIN_PASSWORD=
