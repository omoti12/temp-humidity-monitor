# ============================================================
# templog-backup.service（Googleドライブへのバックアップ）を1時間ごとに実行するタイマー
# 有効にする : sudo systemctl enable --now templog-backup.timer
# ============================================================
[Unit]
Description=Back up temperature logs every hour

[Timer]
# 1時間ごと（毎時0分）。ほかの処理と重ならないよう、0〜5分の範囲でずらして実行する
OnCalendar=hourly
RandomizedDelaySec=5min
# 電源が切れていて実行できなかった分は、起動したときに実行する
Persistent=true

[Install]
WantedBy=timers.target
