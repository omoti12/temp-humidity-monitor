# ============================================================
# sht31-graph.service（グラフ画像の作成）を10分ごとに実行するタイマー
# 予定を見る : systemctl list-timers
# ============================================================
[Unit]
Description=Update SHT31 graph every 10 minutes

[Timer]
# 毎時0分30秒、10分30秒、20分30秒…（その分の記録が書き終わってから）
OnCalendar=*:00/10:30
# 電源が切れていて実行できなかった分は、起動したときに実行する
Persistent=true

[Install]
WantedBy=timers.target
