# ============================================================
# pages-publish.service（公開サイトへの送信）を10分ごとに実行するタイマー
# 予定を見る : systemctl list-timers
# ============================================================
[Unit]
Description=Publish temperature data to GitHub Pages every 10 minutes

[Timer]
# 毎時0分40秒、10分40秒…（その分の記録が書き終わってから）
OnCalendar=*:00/10:40
# 電源が切れていて実行できなかった分は、起動したときに実行する
Persistent=true

[Install]
WantedBy=timers.target
