# ============================================================
# 記録（CSV）をGoogleドライブへ1回コピーする設定
# 実行のタイミングは templog-backup.timer が決める（1時間ごと）
# 先に rclone config で「gdrive」という名前のGoogleドライブ接続を作っておく必要がある
# 手動で今すぐコピー : sudo systemctl start templog-backup
# ============================================================
[Unit]
Description=Back up temperature logs to Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=iot-user
# 記録フォルダをGoogleドライブの「温湿度記録」フォルダへコピーする（増えた分・変わった分だけ送る）
# copy なので、ラズパイ側で消してもドライブ側は消えない
ExecStart=/usr/bin/rclone copy /home/iot-user/templog gdrive:温湿度記録 --include "*.csv"
