# ============================================================
# ラズパイ内のWebサイト（web/app.py）を常に動かし続けるための設定
#   ・社内のネットワークからは http://raspberrypi.local:8000 で画面が見られる
#   ・Tailscale の端末からは https://raspberrypi.tailfa1dcc.ts.net で見られる（tailscale serve で中継）
#   ・インターネットには公開しない
# よく使うコマンド
#   状態を見る : systemctl status temp-web
#   再起動する : sudo systemctl restart temp-web
# ============================================================
[Unit]
Description=Temperature/humidity monitor website
After=network.target

[Service]
WorkingDirectory=/home/iot-user/temp-monitor/web
ExecStart=/usr/bin/python3 /home/iot-user/temp-monitor/web/app.py
# 記録（CSV）のある場所と、サイトの番号（ポート）
Environment=LOG_DIR=/home/iot-user/templog
Environment=PORT=8000
# ラズパイ内サイトにパスワードをかけるときは、下の2行の先頭の # を外して書き換える
# （外部に公開されるのは /api/now の現在値だけ）
#Environment=WEB_USER=admin
#Environment=WEB_PASSWORD=ここを自分のパスワードに変える
# 止まったら10秒後に自動で再起動する
Restart=always
RestartSec=10
User=iot-user

[Install]
WantedBy=multi-user.target
