# ============================================================
# ネットの見張り役（netcheck.py）を常に動かし続けるための設定
#   インターネットにつながらない状態が続いたら、5分でつなぎ直し、15分で再起動する
# よく使うコマンド
#   状態を見る : systemctl status netcheck
#   ログを見る : journalctl -u netcheck -n 20
# ============================================================
[Unit]
Description=Network watchdog (reconnect / reboot when the internet is down)
After=network-online.target
Wants=network-online.target

[Service]
# root として動かすので、iot-user が書き換えられない場所（/usr/local/sbin）に置いたコピーを動かす
# （置き方: sudo install -o root -g root -m 755 ~/temp-monitor/netcheck.py /usr/local/sbin/temp-monitor-netcheck.py）
# netcheck.py を更新したときは、上の install をもう一度実行してから sudo systemctl restart netcheck
ExecStart=/usr/bin/python3 /usr/local/sbin/temp-monitor-netcheck.py
# つなぎ直し・再起動に root の権限が要るので、root として動かす
User=root
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
