[Unit]
Description=SHT31 temperature/humidity logger
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/iot-user/temp-monitor/sht31_logger.py
# 警報メールの設定は /home/iot-user/.config/temp-monitor/mail.env に書く（mail.env.example 参照）
Restart=always
RestartSec=10
User=iot-user

[Install]
WantedBy=multi-user.target
