[Unit]
Description=SHT31 temperature/humidity logger
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/iot-user/temp-monitor/sht31_logger.py
# 警報メールの設定（Gmailの例）。使うときは下の3行の先頭の # を外して書き換える
# 宛先が複数ならカンマ区切り
#Environment=MAIL_USER=送信用アドレス@gmail.com
#Environment=MAIL_PASSWORD=Gmailのアプリパスワード16文字
#Environment=MAIL_TO=受け取るアドレス@example.com
Restart=always
RestartSec=10
User=iot-user

[Install]
WantedBy=multi-user.target
