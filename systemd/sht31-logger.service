[Unit]
Description=SHT31 temperature/humidity logger
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/sht31_logger.py
# 警報メールの設定（Gmailの例）。宛先が複数ならカンマ区切り
Environment=MAIL_USER=送信用アドレス@gmail.com
Environment=MAIL_PASSWORD=Gmailのアプリパスワード16文字
Environment=MAIL_TO=受け取るアドレス@example.com
Restart=always
RestartSec=10
User=pi

[Install]
WantedBy=multi-user.target
