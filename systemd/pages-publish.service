# ============================================================
# 公開サイト（GitHub Pages）へデータを1回送る設定（pages/publish.py を実行して終わる）
# 実行のタイミングは pages-publish.timer が決める（10分ごと）
# 手動で今すぐ送る : sudo systemctl start pages-publish
# ログを見る       : journalctl -u pages-publish -n 20
# ============================================================
[Unit]
Description=Publish temperature data to GitHub Pages
# ネットにつながってから実行する
After=network-online.target
Wants=network-online.target

[Service]
# oneshot = 1回実行して終わるプログラム
Type=oneshot
User=iot-user
ExecStart=/usr/bin/python3 /home/iot-user/temp-monitor/pages/publish.py
