# ============================================================
# Pt100 比較用ロガー（pt100_logger.py）を常に動かし続けるための設定
#   ・ラズパイの電源を入れると自動で起動する
#   ・止まったら（USBが抜けたときなど）10秒後に自動で再起動する
# よく使うコマンド
#   状態を見る   : systemctl status pt100-logger
#   ログを見る   : journalctl -u pt100-logger -n 20
#   止める       : sudo systemctl stop pt100-logger（y2kb_read.py でモジュールを読むとき）
# このファイルを書き換えたら : sudo cp でコピー → sudo systemctl daemon-reload → 再起動
# ============================================================
[Unit]
Description=Pt100 (Y2Kb USB module) comparison logger

[Service]
ExecStart=/usr/bin/python3 /home/iot-user/temp-monitor/pt100_logger.py
Environment=LOG_DIR=/home/iot-user/templog
Environment=SENSOR_NAME=pt100
# モジュールのUSBポート（ttyUSB0・ttyUSB1 の番号は、起動のたびに入れ替わることがある）
# 2つつなぐときは「ls -l /dev/serial/by-path/」で差した場所の名前を確かめ、その名前に書き換えると入れ替わらない
Environment=SENSOR_PORT=/dev/ttyUSB0
WorkingDirectory=/home/iot-user
# 止まったら必ず再起動する（10秒待ってから）
Restart=always
RestartSec=10
# iot-user として動かす（root では動かさない）
User=iot-user

[Install]
WantedBy=multi-user.target
